+@pytest.mark.mnemonic(mnemonics.singlesig)
+@with_test_cases('tests/rpc/data/sign_psbt_anti_exfil/exchange_*.json')
+def test_sign_psbt_ae_exchange(jade, mnemonic, test_case):
+    # The first pass adds the nonce commitments and does not ask for approval.
+    # The second pass asks once, adds the signatures and removes every anti-exfil field.
+    inp, expected = test_case['input'], test_case['expected_output']
+    before = _prompts(jade)
+    first = jade.sign_psbt(inp['network'], inp['first_request'])
+    assert _prompts(jade) == before
+    assert _fields(first, AE_TYPES) == _fields(expected['first_response'], AE_TYPES)
+    assert _fields(first, AE_TYPES) != _fields(inp['first_request'], AE_TYPES)
+    assert not _fields(first, SIGNATURE_TYPES)
+
+    second = jade.sign_psbt(inp['network'], inp['second_request'])
+    if before is not None:
+        assert _prompts(jade) == before + 1
+    assert not _fields(second, AE_TYPES)
+    signatures = _fields(second, SIGNATURE_TYPES)
+    assert signatures
+    expected_signatures = _fields(expected['second_response'], SIGNATURE_TYPES)
+    assert signatures == expected_signatures
+
+
+@pytest.mark.mnemonic(mnemonics.singlesig)
+@with_test_cases('tests/rpc/data/sign_psbt_anti_exfil/refusal_*.json')
+def test_sign_psbt_ae_refusal(jade, mnemonic, test_case):
+    # A request that is not valid fails as a whole: nothing is returned or asked of the user
+    before = _prompts(jade)
+    with pytest.raises(JadeError) as err:
+        jade.sign_psbt(test_case['input']['network'], test_case['input']['psbt'])
+    assert err.value.code == JadeError.BAD_PARAMETERS
+    assert err.value.message == test_case['expected_error']
+    assert _prompts(jade) == before
+
