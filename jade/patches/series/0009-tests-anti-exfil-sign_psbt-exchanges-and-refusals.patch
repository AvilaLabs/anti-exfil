+def _compact(data, offset):
+    first = data[offset]
+    if first < 0xFD:
+        return first, offset + 1
+    size = {0xFD: 2, 0xFE: 4, 0xFF: 8}[first]
+    return int.from_bytes(data[offset + 1:offset + 1 + size], 'little'), offset + 1 + size
+
+
+def _input_maps(psbt_bin):
+    """The key/value maps of the inputs of a psbt (version 0 or 2), as dicts."""
+    psbt_bin = bytes(psbt_bin)
+    assert psbt_bin[:5] == b'psbt\xff'
+    maps = []
+    offset = 5
+    while offset < len(psbt_bin):
+        fields = {}
+        while True:
+            key_len, offset = _compact(psbt_bin, offset)
+            if key_len == 0:
+                break
+            key = psbt_bin[offset:offset + key_len]
+            value_len, offset = _compact(psbt_bin, offset + key_len)
+            fields[key] = psbt_bin[offset:offset + value_len]
+            offset += value_len
+        maps.append(fields)
+    glob = maps[0]
+    if b'\xfb' in glob and int.from_bytes(glob[b'\xfb'], 'little') == 2:
+        num_inputs, _ = _compact(glob[b'\x04'], 0)
+    else:
+        num_inputs, _ = _compact(glob[b'\x00'], 4)
+    return maps[1:1 + num_inputs]
+
+
+def _fields(psbt_bin, key_types):
+    maps = _input_maps(psbt_bin)
+    return {(i, k): v for i, m in enumerate(maps) for k, v in m.items() if k[0] in key_types}
+
+
+def _prompts(jade):
+    # The number of times sign_psbt asked for approval (libjade only)
+    if get_jade_config().transport != 'libjade':
+        return None
+    params = {'request': 'get_test_sign_psbt_prompts'}
+    return int.from_bytes(jade._jadeRpc('libjade_request', params), 'little')
+
