     psbt_bin = test_case['input']['psbt']
     values = {
         AE_HOST_COMMITMENT: bytes(32),
@@ -43,7 +43,7 @@ def test_sign_psbt_ae_fields_not_supported(jade, mnemonic, test_case):
 @pytest.mark.skipif(transport_is_not('libjade'), reason='libjade only')
 @pytest.mark.mnemonic(mnemonics.singlesig)
 @with_test_cases('tests/rpc/data/sign_psbt/psbt_ss_p2wpkh.json')
-def test_sign_psbt_ae_fields_not_supported_without_process(jade, mnemonic, test_case):
