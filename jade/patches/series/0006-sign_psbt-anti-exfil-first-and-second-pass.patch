     # The QR and USB storage modes sign without a process (and display the result)
     psbt_bin = test_case['input']['psbt']
     for key_type in [AE_HOST_COMMITMENT, AE_NONCE_COMMITMENT, AE_HOST_RANDOMNESS]:
