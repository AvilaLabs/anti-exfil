 main/amalgamated.c                     |  1 +
 main/process/sign_psbt.c               | 12 +++++
 main/process/sign_psbt_ae.c            | 63 ++++++++++++++++++++++++++
 main/process/sign_psbt_ae.h            | 21 +++++++++
 tests/rpc/test_sign_psbt_anti_exfil.py | 55 ++++++++++++++++++++++
 6 files changed, 176 insertions(+)
 create mode 100644 main/process/sign_psbt_ae.c
 create mode 100644 main/process/sign_psbt_ae.h
 create mode 100644 tests/rpc/test_sign_psbt_anti_exfil.py

