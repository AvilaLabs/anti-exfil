@@ -442,6 +442,30 @@ void process_libjade_request(const cbor_msg_t* const ctx)
             jade_process_reply_to_message_ok_ex(ctx);
             return;
         }
+    } else if (IS_JADE_REQUEST("test_sign_psbt_no_process")) {
+        // Sign as the QR and USB storage modes do, ie. with no process or params
+        const uint8_t* bytes = NULL;
+        size_t bytes_len = 0;
+        rpc_get_bytes_ptr("bytes", &params, &bytes, &bytes_len);
+        struct wally_psbt* psbt = NULL;
+        if (bytes_len && deserialise_psbt(bytes, bytes_len, &psbt)) {
+            const char* errmsg = NULL;
+            const int errcode = sign_psbt(NULL, NULL, network_from_psbt_type(psbt), psbt, &errmsg);
+            uint8_t* output = NULL;
+            size_t output_len = 0;
+            if (errcode) {
+                jade_process_reject_message_ex(ctx, errcode, errmsg, NULL, 0, buf, sizeof(buf));
+                JADE_WALLY_VERIFY(wally_psbt_free(psbt));
+                return;
+            }
+            if (serialise_psbt(psbt, &output, &output_len)) {
+                jade_process_reply_to_message_bytes(ctx, output, output_len);
+                free(output);
+                JADE_WALLY_VERIFY(wally_psbt_free(psbt));
+                return;
+            }
+            JADE_WALLY_VERIFY(wally_psbt_free(psbt));
+        }
     } else if (IS_JADE_REQUEST("get_nvs")) {
         uint8_t* output;
         size_t output_len;
