(* Control M3: the host reuses one rho across attempts. Q4a and Q4b must be false. *)
set preciseActions = true.

(* Q4a, Q4b: as in setupB.pv. *)
query a1:bitstring, a2:bitstring, m1:bitstring, m2:bitstring, rho:bitstring,
      r1:bitstring, r2:bitstring, w1:bitstring, w2:bitstring, s1:bitstring, s2:bitstring;
  event(HostAccept(a1,m1,rho,r1,w1,s1)) && event(HostAccept(a2,m2,rho,r2,w2,s2)) ==> a1 = a2.
query a1:bitstring, a2:bitstring, m1:bitstring, m2:bitstring, rho1:bitstring, rho2:bitstring,
      r1:bitstring, r2:bitstring, w:bitstring, s1:bitstring, s2:bitstring;
  event(HostAccept(a1,m1,rho1,r1,w,s1)) && event(HostAccept(a2,m2,rho2,r2,w,s2)) ==> a1 = a2.

let dev2(sk:skey) =
  in(net, (m:bitstring, rho:bitstring));
  let r0 = point(base_nonce(sk, m, hdata(rho))) in
  event DeviceR0(m, hdata(rho), r0);
  let w = add(r0, tweak(r0, rho)) in
  event DeviceApproved(m, rho);              (* user approval, abstract *)
  let sg = sign((m,w), sk) in
  event DeviceRelease(m, rho);
  event DeviceOut(m, rho, w, sg);
  out(net, sg).

let host(pkdev:pkey, rho:bitstring) =
  in(net, m:bitstring);
  new att:bitstring;                         (* MUTATION: rho shared by all attempts *)
  event HostDraw(att, rho);
  out(net, (m, hdata(rho)));
  in(net, r0:bitstring);
  event HostRecv(att, r0);
  event HostRelease(att, rho);
  out(net, (m, rho));
  in(net, sg:bitstring);
  let (=m, w:bitstring) = checksign(sg, pkdev) in
  if w = add(r0, tweak(r0, rho)) then
  event HostAccept(att, m, rho, r0, w, sg).

process new sk:skey; out(net, pk(sk)); (!dev1(sk) | !dev2(sk) | (new rho:bitstring; !host(pk(sk), rho)))
