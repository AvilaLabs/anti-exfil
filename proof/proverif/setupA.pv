(* Setup A: honest device, attacker controls the channel. The device key sk
   is secret. The host and both device passes are replicated. Queries Q3, Q4,
   Q6, Q7, and Q5b (a control: the link is public, so rho must leak). *)
set preciseActions = true.

(* Q3: a host accepts (m, rho) only if the device approved that (m, rho). *)
query att:bitstring, m:bitstring, rho:bitstring, r0:bitstring, w:bitstring, sg:bitstring;
  event(HostAccept(att,m,rho,r0,w,sg)) ==> event(DeviceApproved(m,rho)).
(* Q4a, Q4b: as in setupB.pv. *)
query a1:bitstring, a2:bitstring, m1:bitstring, m2:bitstring, rho:bitstring,
      r1:bitstring, r2:bitstring, w1:bitstring, w2:bitstring, s1:bitstring, s2:bitstring;
  event(HostAccept(a1,m1,rho,r1,w1,s1)) && event(HostAccept(a2,m2,rho,r2,w2,s2)) ==> a1 = a2.
query a1:bitstring, a2:bitstring, m1:bitstring, m2:bitstring, rho1:bitstring, rho2:bitstring,
      r1:bitstring, r2:bitstring, w:bitstring, s1:bitstring, s2:bitstring;
  event(HostAccept(a1,m1,rho1,r1,w,s1)) && event(HostAccept(a2,m2,rho2,r2,w,s2)) ==> a1 = a2.
(* Q4c: the R0 a host accepts is the one the device recomputed from this
   attempt's hc, so an R0 recorded in an earlier attempt is never accepted. *)
query att:bitstring, m:bitstring, rho:bitstring, r0:bitstring, w:bitstring, sg:bitstring;
  event(HostAccept(att,m,rho,r0,w,sg)) ==> event(DeviceR0(m,hdata(rho),r0)).
(* Q6a, Q6b: a replayed first or second pass gets the identical answer. *)
query m:bitstring, hc:bitstring, r1:bitstring, r2:bitstring;
  event(DeviceCommit(m,hc,r1)) && event(DeviceCommit(m,hc,r2)) ==> r1 = r2.
query m:bitstring, rho:bitstring, w1:bitstring, w2:bitstring, s1:bitstring, s2:bitstring;
  event(DeviceOut(m,rho,w1,s1)) && event(DeviceOut(m,rho,w2,s2)) ==> w1 = w2 && s1 = s2.
(* Q7: no signature is released without an approval for that exact (m, rho). *)
query m:bitstring, rho:bitstring;
  event(DeviceRelease(m,rho)) ==> event(DeviceApproved(m,rho)).
(* Q5b control: rho is sent on the public channel, so the attacker learns it. *)
query attacker(new rho[]).

let dev2(sk:skey) =
  in(net, (m:bitstring, rho:bitstring));
  let r0 = point(base_nonce(sk, m, hdata(rho))) in
  event DeviceR0(m, hdata(rho), r0);
  let w = add(r0, tweak(r0, rho)) in
  event DeviceApproved(m, rho);              (* user approval, abstract *)
  let sg = sign((m,w), sk) in
  event DeviceRelease(m, rho);
  event DeviceOut(m, rho, w, sg);
  out(net, sg).

let host(pkdev:pkey) =
  in(net, m:bitstring);
  new att:bitstring;
  new rho:bitstring;
  event HostDraw(att, rho);
  out(net, (m, hdata(rho)));
  in(net, r0:bitstring);
  event HostRecv(att, r0);
  event HostRelease(att, rho);
  out(net, (m, rho));
  in(net, sg:bitstring);
  let (=m, w:bitstring) = checksign(sg, pkdev) in
  if w = add(r0, tweak(r0, rho)) then
  event HostAccept(att, m, rho, r0, w, sg).

process new sk:skey; out(net, pk(sk)); (!dev1(sk) | !dev2(sk) | !host(pk(sk)))
